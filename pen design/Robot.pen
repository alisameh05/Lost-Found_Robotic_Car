                      "width": 560,
                      "layout": "vertical",
                      "children": [
                        {
                          "id": "tMvpY",
                          "type": "ref",
                          "ref": "Id3OV",
                          "name": "Open control help without covering Emergency Stop",
                          "descendants": {
                            "QV8iW": {
                              "content": "Gesture directions and stop"
                            },
                            "kDiyK": {
                              "content": "Hold one extended index finger pointing up / down / left / right in the mirrored webcam view to move forward / backward / left / right. A fist, no hand, multiple hands or unclear pointing stops movement. Release movement input to stop."
                            },
                            "fAmxv": {
                              "content": "Hold D-pad up / down / left / right for forward / backward / left / right. Release or conflicting directions stops movement. Circle triggers Emergency Stop. Gestures are inactive."
                            },
                            "MsDJU": {
                              "content": "Pause stops movement and matching while keeping the session active. Stop Search ends it. Emergency Stop stops movement, pauses the session and requires recovery."
                            },
                            "v6A4i": {
                              "content": "A potential match pauses the session. Confirm saves before Found; Reject keeps Lost and Paused. Resolve every failure, acknowledge each one, and explicitly Resume. After Resume, release input and apply it again; reconnecting alone never resumes movement."
                            }
                          }
                        }
                      ]
                    }
